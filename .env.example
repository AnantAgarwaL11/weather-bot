# Optional: enables the constrained LLM intent extractor (and optional rewording).
# Without it the bot runs fully on deterministic rules.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# true = let the LLM reword the deterministic answer (rejected if it adds numbers/SOP ids)
LLM_REPHRASE=false
POLICY_FILE=policies/sops.yaml
HTTP_TIMEOUT=8
# Optional JSON file of verified official alerts (see app/weather/alerts.py)
ALERTS_FILE=
# Frontend -> backend
BACKEND_URL=http://localhost:8000
